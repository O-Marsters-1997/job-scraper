# Postgres
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="job_scraper"
POSTGRES_HOST="db"
POSTGRES_PORT="5432"
POSTGRES_SSLMODE="disable"

# Valkey
VALKEY_ADDR="valkey:6379"

# Api
API_BASE_URL="http://localhost:8080"
INGEST_SERVICE_TOKEN="dev-shared-token"
BRIGHTDATA_PROXY_URL="http://brd-customer-<id>-zone-<zone>:<password>@brd.superproxy.io:33335"
BRIGHTDATA_CA_CERT=""

# Notifications (API)
RESEND_API_KEY=""
NOTIFY_EMAIL_FROM="onboarding@resend.dev"

API_PORT=":8080"
CORS_ALLOWED_ORIGIN="https://*.vercel.app"
COOKIE_SECURE=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/google/oauth/callback
GOOGLE_TOKEN_ENC_KEY=  # generate: openssl rand -base64 32

# Anthropic
ANTHROPIC_API_KEY=

# Session signing
SESSION_SECRET=  # generate: openssl rand -hex 32
