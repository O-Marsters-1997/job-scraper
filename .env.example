# Postgres
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="job_scraper"
POSTGRES_HOST="db"
POSTGRES_PORT="5432"
POSTGRES_SSLMODE="disable"

# RabbitMQ (URL-encode special characters in RABBITMQ_PASSWORD when used in a URL)
RABBITMQ_USER="jobs"
RABBITMQ_PASSWORD="change-me"
RABBITMQ_URL="amqp://jobs:change-me@localhost:5672/"
RABBITMQ_MANAGEMENT_URL="http://localhost:15672"
# Debugging only: lets a breakpoint pause the worker without RabbitMQ dropping its connections.
# AMQP negotiates the lower of the two heartbeats, so raise both. Server 0 disables its heartbeat
# (recreate the rabbitmq container to apply); client is whole seconds, e.g. 1800. Leave both unset normally.
RABBITMQ_SERVER_HEARTBEAT=60
# RABBITMQ_HEARTBEAT=1800

# Logging (defaults: LOG_FORMAT=json, LOG_LEVEL=info; just run/run-api set text+debug)
LOG_FORMAT=""
LOG_LEVEL=""

# Tracing (unset endpoint = no spans; just tracing-up serves OTLP on :4318; just run/run-api set the service names)
OTEL_EXPORTER_OTLP_ENDPOINT=""

# Api
API_BASE_URL="http://localhost:8080"
INGEST_SERVICE_TOKEN="dev-shared-token"

# Notifications 
RESEND_API_KEY=""
NOTIFY_EMAIL_FROM="onboarding@resend.dev"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/api/google/oauth/callback
GOOGLE_TOKEN_ENC_KEY=  # generate: openssl rand -base64 32

# AI credentials
AI_CREDENTIAL_ENC_KEY=

# Proxies
DECODO_PROXY_URL="http://user-<username>-country-gb:<password>@gate.decodo.com:7000"
INDEED_API_KEY=""
# Worker: stop paginating a Source Target after N listing pages (unset or 0 = no cap). Handy locally.
SCRAPE_MAX_PAGES=""

# Session signing
SESSION_SECRET=  # generate: openssl rand -hex 32

API_PORT=":8080"
CORS_ALLOWED_ORIGIN="http://localhost:8000"
COOKIE_SECURE=false

# Grafana Cloud
GRAFANA_CLOUD_PROM_URL="https://prometheus-prod-00-prod-eu-west-0.grafana.net/api/prom/push"
GRAFANA_CLOUD_PROM_USER="1234567"
GRAFANA_CLOUD_LOKI_URL="https://logs-prod-000.grafana.net/loki/api/v1/push"
GRAFANA_CLOUD_LOKI_USER="7654321"
GRAFANA_CLOUD_TOKEN="glc_your-access-policy-token"

# Alloy (observability profile): unset = container api/worker, tagged env="dev"
ALLOY_ENV="dev"
API_METRICS_TARGET="host.docker.internal:9091"
WORKER_METRICS_TARGET="host.docker.internal:9092"

# Grafana stack API: just grafana-push
GRAFANA_URL="https://your-stack.grafana.net"
GRAFANA_SA_TOKEN="glsa_your-service-account-token"

# just eval-tailoring: real Sonnet via OpenRouter
OPENROUTER_API_KEY="sk-or-your-key"

# Web Push (API): leave unset to disable push. Generate a pair with `just vapid-keys`.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Decodo proxy quota on Settings -> Usage (admin only): unset = shown as not configured, no calls made
DECODO_API_KEY=""
