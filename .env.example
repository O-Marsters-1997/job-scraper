POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="job_scraper"
POSTGRES_HOST="db"
POSTGRES_PORT="5432"
POSTGRES_SSLMODE="disable"

# Notifications (worker)
RESEND_API_KEY=""
NOTIFY_EMAIL_TO=""
NOTIFY_EMAIL_FROM="onboarding@resend.dev"
NOTIFY_DIGEST_CRON="0 9 * * *"
NOTIFY_ON_INGEST="false"
NOTIFY_DIGEST_ENABLED="true"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/google/oauth/callback
GOOGLE_TOKEN_ENC_KEY=  # generate: openssl rand -base64 32

# Session signing
SESSION_SECRET=  # generate: openssl rand -hex 32