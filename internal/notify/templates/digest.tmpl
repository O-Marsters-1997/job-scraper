<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html dir="ltr" lang="en">
  <head></head>
  <body style="background-color:#f9fafb">
    <!--$--><!--html--><!--body-->
    <table
      border="0"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      role="presentation"
      align="center">
      <tbody>
        <tr>
          <td
            style='background-color:#f9fafb;font-family:-apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif'>
            <table
              align="center"
              width="100%"
              border="0"
              cellpadding="0"
              cellspacing="0"
              role="presentation"
              style="max-width:600px;margin:0 auto;background-color:#ffffff;padding:32px;border-radius:8px">
              <tbody>
                <tr style="width:100%">
                  <td>
                    <h1
                      style="font-size:24px;font-weight:700;color:#111827;margin:0 0 8px">
                      Job Digest
                    </h1>
                    <p
                      style="font-size:14px;line-height:24px;color:#6b7280;margin:0 0 24px;margin-top:0;margin-right:0;margin-bottom:24px;margin-left:0">
                      New jobs since your last digest
                    </p>
                    {{range .Jobs}}
                    <table
                      align="center"
                      width="100%"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      role="presentation"
                      style="padding:16px 0">
                      <tbody>
                        <tr>
                          <td>
                            <h2
                              style="font-size:18px;font-weight:600;color:#111827;margin:0 0 4px">
                              {{.Title}}
                            </h2>
                            <p
                              style="font-size:14px;line-height:24px;color:#6b7280;margin:0 0 8px;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">
                              {{.Company}}<!-- -->
                              ·
                              <!-- -->{{.Location}}
                            </p>
                            <a
                              href="{{.URL}}"
                              style="color:#2563eb;text-decoration-line:none;font-size:14px;text-decoration:none"
                              target="_blank"
                              >View Job →</a
                            >
                            <hr
                              style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#e5e7eb;margin:16px 0 0" />
                          </td>
                        </tr>
                      </tbody>
                    </table>
                    {{end}}
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </tbody>
    </table>
    <!--/$-->
  </body>
</html>
