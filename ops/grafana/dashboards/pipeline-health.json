{
  "uid": "jobscraper-pipeline-health",
  "title": "Pipeline health",
  "timezone": "browser",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Service up",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "__PROM_DATASOURCE_UID__" },
      "targets": [
        { "refId": "A", "expr": "up{job=~\"api|worker\"}", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 2,
      "title": "Logs by service and level",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "__LOKI_DATASOURCE_UID__" },
      "targets": [
        { "refId": "A", "expr": "{env=\"prod\"}" }
      ]
    },
    {
      "id": 3,
      "title": "Outbox pending",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "__PROM_DATASOURCE_UID__" },
      "targets": [
        { "refId": "A", "expr": "jobscraper_outbox_pending", "legendFormat": "pending" },
        { "refId": "B", "expr": "jobscraper_outbox_failed", "legendFormat": "failed" }
      ]
    },
    {
      "id": 4,
      "title": "Outbox oldest pending age",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "__PROM_DATASOURCE_UID__" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "jobscraper_outbox_oldest_pending_seconds", "legendFormat": "oldest pending" }
      ]
    },
    {
      "id": 5,
      "title": "Queue wait p95 by source and kind",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "__LOKI_DATASOURCE_UID__" },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {env=\"prod\"} | json event=\"event\" | event=\"task.done\" | unwrap wait_ms [5m]) by (source, kind)",
          "legendFormat": "{{source}} / {{kind}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Task duration p95 by source and kind",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "loki", "uid": "__LOKI_DATASOURCE_UID__" },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {env=\"prod\"} | json event=\"event\" | event=\"task.done\" | unwrap duration_ms [5m]) by (source, kind)",
          "legendFormat": "{{source}} / {{kind}}"
        }
      ]
    }
  ]
}
