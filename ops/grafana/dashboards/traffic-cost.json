{
  "uid": "jobscraper-traffic-cost",
  "title": "Traffic & cost",
  "timezone": "browser",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "custom",
        "query": "prod,dev",
        "current": { "text": "prod", "value": "prod" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "__LOKI_DATASOURCE_UID__" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate({env=\"$env\"} | json | event=\"http.request\" [5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "__LOKI_DATASOURCE_UID__" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate({env=\"$env\"} | json | event=\"http.request\" | status >= 500 [5m])) / sum by (service) (rate({env=\"$env\"} | json | event=\"http.request\" [5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 duration by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "__LOKI_DATASOURCE_UID__" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {env=\"$env\"} | json | event=\"http.request\" | unwrap duration_ms [5m]) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Scoring spend per day",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "__LOKI_DATASOURCE_UID__" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time({env=\"$env\"} | json | event=\"score.call\" | unwrap cost_usd [1d]))",
          "legendFormat": "spend"
        }
      ]
    },
    {
      "id": 5,
      "title": "Top users by 24h scoring cost",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "loki", "uid": "__LOKI_DATASOURCE_UID__" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (user_id) (sum_over_time({env=\"$env\"} | json | event=\"score.call\" | unwrap cost_usd [24h])))",
          "legendFormat": "{{user_id}}",
          "instant": true
        }
      ]
    }
  ]
}
