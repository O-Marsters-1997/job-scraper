    {
      "id": "59a6c7dea71f49dda72a",
      "type": "text",
      "x": 40,
      "y": 554,
      "width": 285,
      "height": 403.75,
      "angle": 0,
      "strokeColor": "#59697b",
      "backgroundColor": "transparent",
